# Development env helpers (vars,
# functions, workarounds, aliases,
# plugins, etc..
export EDITOR=vim
export VISUAL=vim
export MAIL=/var/spool/mail/nick
export FIGNORE='.swp:.un~'

is_bash() { test -n "$BASH_VERSION"; }
is_zsh() { test -n "$ZSH_VERSION"; }

screenshot() {
  local outdir=${outdir:-$HOME/Pictures}
  local filename="${outfile:-screenshot-`date +'%b-%d-%y_%H:%M:%S'`}.jpg"
  local imgviewer="${imgviewer:-feh}"
  local file="${outdir}/${filename}"
  test -d $outdir || mkdir -p $outdir
  echo "## Select the screen region."
  echo "## Will save it in $file"
  gm import "$@" "$file" && ${imgviewer} "$file"&
}

get_external_ip() {
  curl -s http://whatismyip.org/ | grep -oP '(\d{1,3}\.){3}\d+'
}

trust_key() {
  local key=$1
  gpg --recv-key $key
  gpg --lsign $key
}

# SSH_AUTH_SOCK changes on every reconnect, breaking persistent tmux sessions.
# Keep a stable symlink and refresh it whenever SSH forwards a live socket
# (covers both regular agent forwarding and luci-auth-ssh-helper for FIDO2 reauth).
_fixed_sock="$HOME/.ssh/ssh_auth_sock"
if [ -n "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$_fixed_sock" ] && [ -S "$SSH_AUTH_SOCK" ]; then
  ln -sf "$SSH_AUTH_SOCK" "$_fixed_sock"
  export SSH_AUTH_SOCK="$_fixed_sock"
fi
unset _fixed_sock

# source tools' env scripts.
tools_dir=~/devtools
if [ -d ~/.tools-env.d ]; then
  for env_script in ~/.tools-env.d/*.sh; do
    if [ -r $env_script ]; then
      . $env_script
    fi
  done
  unset env_script
fi

if [ -r ~/.bin/graphical-session-helpers.sh ]; then
  source ~/.bin/graphical-session-helpers.sh
fi

if [ -r ~/.localenv ]; then
  source ~/.localenv
fi

